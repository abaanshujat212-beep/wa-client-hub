# Copy this file to .env.docker and replace every change-me value.
POSTGRES_DB=wa_hub
POSTGRES_USER=wa_hub
POSTGRES_PASSWORD=change-me-database-password
SESSION_SECRET=change-me-use-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3131
APP_ORIGIN=http://127.0.0.1:3131
COOKIE_SECURE=false
APP_NAME=WA Client Hub
REMOTE_DESKTOP_URL=
CONNECTOR_MASTER_KEY=change-me-base64-encoded-32-byte-key
CONNECTOR_KEY_ID=v1
OPENWA_API_KEY=change-me-openwa-api-key
OPENWA_SESSION_ID=primary
OPENWA_WEBHOOK_SECRET=change-me-openwa-webhook-secret

# Enable only after the public HTTPS hostname and Meta credentials are ready.
META_SIGNUP_ENABLED=false
META_WEBHOOK_ENABLED=false
META_SIGNUP_CLEANUP_INTERVAL_MS=300000
META_GRAPH_VERSION=
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
META_MEDIA_CLEANUP_INTERVAL_MS=
META_MEDIA_CLEANUP_BATCH_SIZE=

# GHL private Marketplace pilot values. Keep secrets local/server-side only.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=https://wa.10xcollab.com/oauth/crm/callback
GHL_AUTH_URL=https://marketplace.gohighlevel.com/oauth/chooselocation
GHL_TOKEN_URL=https://services.leadconnectorhq.com/oauth/token
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2023-02-21
GHL_REQUIRED_SCOPES=conversations.write
GHL_PUBLIC_KEY=

# Production override only: immutable image published by CI/your registry.
APP_IMAGE=ghcr.io/your-organization/wa-client-hub:replace-with-version
