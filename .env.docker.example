# Copy this file to .env.docker and replace every change-me value.
POSTGRES_DB=wa_hub
POSTGRES_USER=wa_hub
POSTGRES_PASSWORD=change-me-database-password
SESSION_SECRET=change-me-use-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3131
APP_ORIGIN=http://127.0.0.1:3131
COOKIE_SECURE=false
APP_NAME=WA Client Hub
REMOTE_DESKTOP_URL=
CONNECTOR_MASTER_KEY=change-me-base64-encoded-32-byte-key
CONNECTOR_KEY_ID=v1
OPENWA_API_KEY=change-me-openwa-api-key
OPENWA_SESSION_ID=primary
OPENWA_WEBHOOK_SECRET=change-me-openwa-webhook-secret

# Enable only after the public HTTPS hostname and Meta credentials are ready.
META_SIGNUP_ENABLED=false
META_WEBHOOK_ENABLED=false
META_GRAPH_VERSION=
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=

# Production override only: immutable image published by CI/your registry.
APP_IMAGE=ghcr.io/your-organization/wa-client-hub:replace-with-version
