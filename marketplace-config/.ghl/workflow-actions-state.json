        "key": "tenx_wa_send_media",
        "versions": [
          {
            "version": "1.0",
            "status": "draft",
            "info": {
              "name": "10x WA — Send Media",
              "description": "Send uploaded WhatsApp media within an eligible conversation window.",
              "summary": "Send uploaded WhatsApp media within an eligible conversation window. Uses connected numbers, consent and suppression checks."
            },
            "inputs": [
              {
                "field": "DYNAMIC",
                "title": "WhatsApp settings",
                "required": false,
                "fieldType": "DYNAMIC",
                "dynamicFieldsConfig": {
                  "url": "https://wa.10xcollab.com/webhooks/ghl/workflow-fields",
                  "headers": {
                    "x-tenx-workflow-key": "${remote}"
                  }
                }
              },
              {
                "field": "recipient_phone",
                "title": "Recipient Phone",
                "required": true,
                "fieldType": "string",
                "validations": [],
                "value": "{{contact.phone}}",
                "altersDynamicField": false,
                "allowCustomInputPicker": true
              },
              {
                "field": "request_id",
                "title": "Request ID",
                "required": true,
                "fieldType": "string",
                "helpText": "Unique business event + step ID. Keep unchanged on retries; change for a new intended send.",
                "allowCustomInputPicker": true
              },
              {
                "field": "dry_run",
                "title": "Dry Run",
                "required": false,
                "fieldType": "toggle",
                "helpText": "Validate contact and sender without sending.",
                "value": "true",
                "allowCustomInputPicker": true
              },
              {
                "field": "media_type",
                "title": "Media Type",
                "required": true,
                "fieldType": "select",
                "options": [
                  {
                    "label": "image",
                    "value": "image"
                  },
                  {
                    "label": "audio",
                    "value": "audio"
                  },
                  {
                    "label": "video",
                    "value": "video"
                  },
                  {
                    "label": "document",
                    "value": "document"
                  }
                ],
                "allowCustomInputPicker": true
              },
              {
                "field": "media_id",
                "title": "Meta Media ID",
                "required": true,
                "fieldType": "string",
                "helpText": "Uploaded Meta Media ID, not a URL.",
                "allowCustomInputPicker": true
              },
              {
                "field": "caption",
                "title": "Caption",
                "required": false,
                "fieldType": "textarea",
                "allowCustomInputPicker": true
              },
              {
                "field": "filename",
                "title": "File Name",
                "required": false,
                "fieldType": "string",
                "allowCustomInputPicker": true
              }
            ],
            "customVars": [
              {
                "name": "Success",
                "reference": "success",
                "fieldType": "boolean"
              },
              {
                "name": "Status",
                "reference": "status",
                "fieldType": "string"
              },
              {
                "name": "Message ID",
                "reference": "message_id",
                "fieldType": "string"
              },
              {
                "name": "Duplicate",
                "reference": "duplicate",
                "fieldType": "boolean"
              },
              {
                "name": "Error Code",
                "reference": "error_code",
                "fieldType": "string"
              }
            ],
            "customVarsJson": {
              "success": true,
              "status": "validated",
              "message_id": "example-message-id",
              "duplicate": false,
              "error_code": ""
            },
            "executionConfig": {
              "type": "API",
              "url": "https://wa.10xcollab.com/webhooks/ghl/workflow-action",
              "method": "POST",
              "headers": {
                "Content-Type": "application/json",
                "x-tenx-workflow-key": "${remote}"
              },
              "pauseExecution": false
            },
            "payloadCustomizationType": "default",
            "customizedPayload": {},
            "branchesConfig": {}
          }
