      "info": {
        "name": "10x WA — Send Message",
        "description": "Send a WhatsApp text reply within an eligible conversation window.",
        "summary": "Send a WhatsApp text reply within an eligible conversation window. Uses connected numbers, consent and suppression checks."
      },
      "inputs": [
