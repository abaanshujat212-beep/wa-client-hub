            "headers": {
              "x-tenx-workflow-key": "${remote}"
            }
          }
        },
        {
          "field": "recipient_phone",
          "title": "Recipient Phone",
          "required": true,
          "fieldType": "string",
          "validations": [],
          "value": "{{contact.phone}}",
          "altersDynamicField": false,
          "allowCustomInputPicker": true
        },
        {
          "field": "request_id",
          "title": "Request ID",
          "required": true,
          "fieldType": "string",
          "helpText": "Unique business event + step ID. Keep unchanged on retries; change for a new intended send.",
          "allowCustomInputPicker": true
        },
        {
          "field": "dry_run",
