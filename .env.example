PORT=3131
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeNow123!
APP_NAME=WA Client Hub
COOKIE_SECURE=false
# BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
MOCK_BROWSER=0

# Remote desktop / Guacamole access
REMOTE_DESKTOP_URL=
REMOTE_DESKTOP_LABEL=Open Remote Desktop
REMOTE_DESKTOP_HELP=Use this to access the Windows desktop where WhatsApp Web opens. Do not expose raw RDP publicly.

# Swich payment provider sandbox
SWICH_API_BASE_URL=https://sandbox-api.swichnow.com
